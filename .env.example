# Exposed to the browser (Safe with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (Do NOT expose to client components)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Integration
OPENAI_API_KEY=sk-proj-your-openai-api-key

# n8n Agent Webhook Endpoints
N8N_WEBHOOK_CAREER_DNA=https://your-n8n-domain/webhook/career-dna
N8N_WEBHOOK_RESUME_ANALYSIS=https://your-n8n-domain/webhook/resume-ats-match
N8N_WEBHOOK_NEXT_ACTION=https://your-n8n-domain/webhook/next-best-action
